    {
      "id": 3,
      "title": "Escopo deste dashboard",
      "type": "text",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "### Métricas do Pricing\nPrometheus fornece os gráficos abaixo. **Tracing no Grafana requer Tempo** e **logs requerem Loki**; esses backends serão adicionados em uma etapa própria."
      }
    },
    {
      "id": 4,
      "title": "Requisições HTTP por segundo",
      "type": "timeseries",
      "description": "Taxa de requisições atendidas, separada por método e rota.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"pricing\",uri=~\"$uri\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}",
          "range": true,
          "instant": false
        }
      ]
    },
